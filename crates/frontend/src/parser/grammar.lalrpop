use std::str::FromStr;

grammar;

pub Term: i32 = {
    <n:Int> => n,
    "(" <t:Term> ")" => t,
};

Int: i32 = <s:r"[0-9]+"> => i32::from_str(s).unwrap();
LongInt: i64 = "L" <s:r"[0-9]+"> => i64::from_str(s).unwrap();
Float: f32 = "f" <s:r"[0-9]*\.[0-9]+"> => f32::from_str(s).unwrap();
Double: f64 = <s:r"[0-9]*\.[0-9]+"> => f64::from_str(s).unwrap();